{
  "appId": "com.pedroqueiroz.qrzspace",
  "productName": "QrzSpace",
  "copyright": "Copyright © Pedro Queiroz",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*",
    "node_modules/@lydell/**/*"
  ],
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "build/icon.png"
    }
  ],
  "publish": null,
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "QrzSpace-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "QrzSpace",
    "uninstallDisplayName": "QrzSpace",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  },
  "mac": {
    "target": [
      "dmg"
    ],
    "icon": "build/icon.png"
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "build/icon.png"
  }
}
