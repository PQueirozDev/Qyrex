{
  "appId": "com.pedroqueiroz.workspace",
  "productName": "PQueiroz Workspace",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "build/icon.png"
    }
  ],
  "win": {
    "target": ["nsis"],
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "PQueiroz Workspace"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "build/icon.png"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "build/icon.png"
  }
}
