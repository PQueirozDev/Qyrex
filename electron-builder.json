{
  "appId": "com.pedroqueiroz.qrzspace",
  "productName": "Qyrex",
  "copyright": "Copyright © Pedro Queiroz",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*",
    "node_modules/@lydell/**/*"
  ],
  "extraResources": [
    {
      "from": "build/icon.png",
      "to": "build/icon.png"
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "PQueirozDev",
      "repo": "QrzSpace-releases",
      "releaseType": "release"
    }
  ],
  "npmRebuild": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "Qyrex-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Qyrex",
    "uninstallDisplayName": "Qyrex",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  }
}
